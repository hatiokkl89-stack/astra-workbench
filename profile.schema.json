{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent profile",
  "type": "object",
  "required": [
    "name",
    "bio",
    "skills",
    "wallet_address"
  ],
  "additionalProperties": false,
  "$defs": {
    "nonblank": {
      "type": "string",
      "pattern": "\\S"
    }
  },
  "properties": {
    "name": {
      "$ref": "#/$defs/nonblank"
    },
    "bio": {
      "$ref": "#/$defs/nonblank"
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonblank"
      }
    },
    "wallet_address": {
      "description": "20-byte EVM address; format only, not ownership or checksum.",
      "type": "string",
      "minLength": 42,
      "maxLength": 42,
      "pattern": "^0x[0-9A-Fa-f]{40}$"
    }
  }
}
